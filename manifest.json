{
  "manifest_version": 3,
  "name": "抖音精读",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "在公开抖音视频旁阅读中文逐字稿、搜索内容、理解观点并保存时间戳笔记。",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://api.supadata.ai/*",
    "https://api.deepseek.com/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://openspeech.bytedance.com/*",
    "https://*.douyinvod.com/*"
  ],
  "action": {
    "default_title": "打开抖音精读",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
